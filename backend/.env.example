PORT=5000
NODE_ENV=development

JWT_SECRET=change_this_super_secret_jwt_key_in_production_use_256bit_random
JWT_EXPIRES_IN=7d
EIN_ENCRYPTION_KEY=change_this_independent_256bit_encryption_secret
SENSITIVE_DATA_ENCRYPTION_KEY=change_this_independent_256bit_sensitive_data_secret
XRPL_RPC_URL=https://s1.ripple.com:51234/
ONBOARDING_FEE_USD=1000
ONBOARDING_RENEWAL_FEE_USD=100
ONBOARDING_COVERAGE_MONTHS=12
ONBOARDING_PAYMENT_ASSET=XRP
ONBOARDING_PAYMENT_NETWORK=XRPL Mainnet
ONBOARDING_PAYMENT_AMOUNT=replace_with_current_approved_xrp_quote
ONBOARDING_PAYMENT_DESTINATION=replace_with_authorized_xrp_address
ONBOARDING_PAYMENT_DESTINATION_TAG=
ONBOARDING_QUOTE_VALID_UNTIL=replace_with_future_iso_timestamp

DB_PATH=./database.sqlite

# Namecheap Private Email config
SMTP_HOST=mail.privateemail.com
SMTP_PORT=465
SMTP_USER=support@digitalwealthpartnersllc.net
SMTP_PASS=replace_with_private_email_app_password
EMAIL_FROM=Digital Wealth Partners <support@digitalwealthpartnersllc.net>
ADMIN_NOTIFY_EMAIL=support@digitalwealthpartnersllc.net

# Frontend URL for CORS
FRONTEND_URL=http://localhost:3000

# Admin seed credentials (used on first boot)
ADMIN_EMAIL=support@digitalwealthpartnersllc.net
ADMIN_PASSWORD=Admin@SecurePass123
ADMIN_FIRST_NAME=Super
ADMIN_LAST_NAME=Admin

# Set to false to disable email alerts when users submit KYC verification.
KYC_ADMIN_EMAIL_NOTIFICATIONS=true
